 <!DOCTYPE html>
    <html lang="zh-TW">
    <head>
      <meta charset="UTF-8">
      <title>百萬年後：透明生物的自割與再生</title>
      <style>
        body {
          margin: 0;
          overflow: hidden;
          background: #04050a;
          font-family: sans-serif;
        }
         #status-tag {
      position: absolute;
      top: 15px;
      left: 15px;
      font-size: 13px;
      font-weight: 600;
      color: #ffdd44;
      pointer-events: none;
      background: rgba(0, 0, 0, 0.55);
      padding: 6px 14px;
      border-radius: 6px;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

      </style>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    </head>
    <body>
       <div id="status-tag">移動中（觸角靜止）</div>
    
      <script>
        // ----------------------------------------------------
        // 1. 場景、相機與渲染器
        // ----------------------------------------------------
        const scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x060810, 0.038);
    
        const camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 100);
        camera.position.set(0, 3.2, 5.8);
    
        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.25;
        document.body.appendChild(renderer.domElement);
    
        const controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.05;
        controls.maxPolarAngle = Math.PI / 2 - 0.05;
    
        // ----------------------------------------------------
        // 2. 環境光芒（紫紅反射光、黃花、白花與毒物光源）
        // ----------------------------------------------------
        const ambientLight = new THREE.AmbientLight(0x0a101d, 0.7);
        scene.add(ambientLight);
    
        const purpleGroundLight = new THREE.HemisphereLight(0x1a2536, 0x4a0a28, 1.3);
        scene.add(purpleGroundLight);
    
        const yellowLight = new THREE.PointLight(0xffea00, 3.2, 10);
            yellowLight.position.set(-2.2, 0.8, -0.6);
            scene.add(yellowLight);
        
       // ★ 白花照明舞台：強光精確投射於右前方花群與毒物沉積點上方
        const whiteLight = new THREE.PointLight(0xffffff, 4.5, 9);
            whiteLight.position.set(0.70, 0.75, 2.05);
            scene.add(whiteLight);
        
       // ★ 有害物質釋放的暗綠毒性螢光（與白花亮光交織，極度清晰）
        const toxicLight = new THREE.PointLight(0x00ff88, 2.5, 3.5);
            toxicLight.position.set(0.55, 0.25, 2.05);
            scene.add(toxicLight);

    
        // ----------------------------------------------------
        // 3. 環境實體：約 70% 覆蓋率重金屬耐受植被（露出暗黑土壤襯托生物）
        // ----------------------------------------------------
        // 底層基底：設定為極深紫黑絨土，即便微小間隙也透不出死板黑泥
        const groundGeo = new THREE.PlaneGeometry(32, 32);
        const groundMat = new THREE.MeshStandardMaterial({ color: 0x18030c, roughness: 0.98 });
        const ground = new THREE.Mesh(groundGeo, groundMat);
        ground.rotation.x = -Math.PI / 2;
        scene.add(ground);
    
        // ★ 高細節 3D 立體草簇幾何（每叢由 4片具備中脊折線、自然微彎的立體草葉組成）
            function createGrassTuftGeometry() {
              const positions = [];
              const indices = [];
              let vertOffset = 0;

              // 4 片不同長度、角度與向外微彎弧度的細緻草葉
              const blades = [
                { height: 0.36, bend: 0.12, rot: 0.25, width: 0.038 },
                { height: 0.30, bend: 0.09, rot: 1.85, width: 0.032 },
                { height: 0.34, bend: 0.11, rot: 3.40, width: 0.035 },
                { height: 0.27, bend: 0.08, rot: 4.90, width: 0.030 }
              ];

              const segs = 4; // 垂直 4 段細分，曲面自然流暢

              blades.forEach(b => {
                const cosR = Math.cos(b.rot);
                const sinR = Math.sin(b.rot);

                for (let i = 0; i <= segs; i++) {
                  const t = i / segs;
                  const y = t * b.height;
                  // 向上自然向外彎垂的二次方曲線
                  const curve = Math.pow(t, 1.8) * b.bend;
                  // 向上漸縮尖端（尖端精細收攏）
                  const w = b.width * (1.0 - t * 0.95);
                  // 中肋 V 字折線立體深度，形成真實草葉的雙向受光折射
                  const crease = 0.010 * (1.0 - t);

                  const lx = -w * 0.5;
                  const ly = y;
                  const lz = curve;

                  const mx = 0;
                  const my = y;
                  const mz = curve + crease;

                  const rx = w * 0.5;
                  const ry = y;
                  const rz = curve;

                  [ [lx, ly, lz], [mx, my, mz], [rx, ry, rz] ].forEach(([px,
                  py, pz]) => {
                    const rotX = px * cosR - pz * sinR;
                    const rotZ = px * sinR + pz * cosR;
                    positions.push(rotX, py, rotZ);
                  });

                  if (i < segs) {
                    const rowA = vertOffset + i * 3;
                    const rowB = vertOffset + (i + 1) * 3;
    
                    // 左半葉雙三角形
                    indices.push(rowA, rowB, rowA + 1);
                    indices.push(rowA + 1, rowB + 1, rowB + 1);
    
                    // 右半葉雙三角形
                    indices.push(rowA + 1, rowB + 1, rowA + 2);
                    indices.push(rowA + 2, rowB + 1, rowB + 2);
                  }
                }
                vertOffset += (segs + 1) * 3;
              });

              const geom = new THREE.BufferGeometry();
              geom.setAttribute('position', new
              THREE.Float32BufferAttribute(positions, 3));
              geom.setIndex(indices);
              geom.computeVertexNormals();
              return geom;
            }

            const grassGeo = createGrassTuftGeometry();

            // 雙面微光草葉材質（天鵝絨微毛與角質蠟層質感）
            const grassMat = new THREE.MeshStandardMaterial({
              roughness: 0.78,
              metalness: 0.04,
              side: THREE.DoubleSide
            });
        
            // ★ 約 70% 覆蓋率：隨機分佈 1,900 叢立體草簇，留下 30% 暗沉土壤
            const gridDim = 52;
            const totalSlots = gridDim * gridDim; // 2,704 個網格點
            const leafCount = Math.floor(totalSlots * 0.70); // 70% 密度（約1,892 叢）
            const foliage = new THREE.InstancedMesh(grassGeo, grassMat,
            leafCount);
            const dummy = new THREE.Object3D();
        
            const range = 13.0; // 覆蓋整個鏡頭視野範圍 (-6.5 到 +6.5)
            const spacing = range / gridDim; // 每株間距約 0.25
        
            // 色彩庫
            const colorPalette = [
              new THREE.Color(0x38041c), new THREE.Color(0x4a0725), new
              THREE.Color(0x200210), new THREE.Color(0x56092a), //深紫紅/暗黑紫
              new THREE.Color(0x452712), new THREE.Color(0x523318), // 古銅褐
              new THREE.Color(0x597270), new THREE.Color(0x475e5c), //白霜灰藍綠 (Glaucous)
              new THREE.Color(0x9ca4aa), new THREE.Color(0xb5bcc2), //銀白絨毛
              new THREE.Color(0x786c3b), new THREE.Color(0x8a7d45)  //黃白失綠斑
            ];
        
            // 收集所有網格座標並隨機打亂，僅選取 70% 的位置放置草叢
            const coords = [];
            for (let i = 0; i < gridDim; i++) {
              for (let j = 0; j < gridDim; j++) {
                coords.push({ i, j });
              }
            }
            for (let i = coords.length - 1; i > 0; i--) {
              const j = Math.floor(Math.random() * (i + 1));
              [coords[i], coords[j]] = [coords[j], coords[i]];
            }
        
            for (let k = 0; k < leafCount; k++) {
              const { i, j } = coords[k];
              const jitterX = (Math.random() - 0.5) * spacing ;
              const jitterZ = (Math.random() - 0.5) * spacing ;
              const x = -range / 2 + i * spacing + jitterX;
              const z = -range / 2 + j * spacing + jitterZ;
        
              dummy.position.set(x, 0.0, z);
              // 隨機朝向與微幅傾斜
              dummy.rotation.set((Math.random() - 0.5) * 0.15, Math.random()
              * Math.PI * 2, (Math.random() - 0.5) * 0.15);
        
              // 尺寸自然起伏（0.8 ~ 1.25）
              const s = 0.8 + Math.random() * 0.45;
              dummy.scale.set(s, s, s);
              dummy.updateMatrix();
              foliage.setMatrixAt(k, dummy.matrix);
        
              // 隨機葉色分配
              const rand = Math.random();
              let pickedColor;
              if (rand < 0.52)      pickedColor =
              colorPalette[Math.floor(Math.random() * 4)];
              else if (rand < 0.67) pickedColor = colorPalette[4 +
              Math.floor(Math.random() * 2)];
              else if (rand < 0.82) pickedColor = colorPalette[6 +
              Math.floor(Math.random() * 2)];
              else if (rand < 0.93) pickedColor = colorPalette[8 +
              Math.floor(Math.random() * 2)];
              else                  pickedColor = colorPalette[10 +
              Math.floor(Math.random() * 2)];
        
              foliage.setColorAt(k, pickedColor);
            }
            foliage.instanceColor.needsUpdate = true;
            scene.add(foliage);


        // ★ 刺目的高飽和度花朵（長在厚厚植被上方）
        function createVividFlower(x, z, type) {
          const flower = new THREE.Group();
          flower.position.set(x, 0.09, z); // 略微提高避免被厚草淹沒

          const isYellow = (type === 'yellow');
          const flowerColor = isYellow ? 0xffea00 : 0xffffff;

          const petalGeo = new THREE.ConeGeometry(0.09, 0.2, 5);
          const petalMat = new THREE.MeshStandardMaterial({
            color: flowerColor,
            emissive: flowerColor,
            emissiveIntensity: isYellow ? 0.95 : 0.85,
            roughness: 0.1
          });

          for (let i = 0; i < 5; i++) {
            const p = new THREE.Mesh(petalGeo, petalMat);
            p.rotation.z = 0.85;
            p.rotation.y = (i * Math.PI * 2) / 5;
            flower.add(p);
          }

          const coreGeo = new THREE.SphereGeometry(0.05, 8, 8);
          const coreMat = new THREE.MeshBasicMaterial({ color: isYellow ? 0xffea00 : 0xffffff });
          const core = new THREE.Mesh(coreGeo, coreMat);
          core.position.y = 0.08;
          flower.add(core);

          scene.add(flower);
        }

      createVividFlower(-2.6, -0.5, 'yellow');
      createVividFlower(-2.2, -0.8, 'white');
      createVividFlower(-1.4, 1.8, 'yellow');
      createVividFlower(2.4, 0.8, 'white');

      // ★ 焦點照明區：共生在毒晶旁的純白花與亮黃花（提供高反差照射背景）
            createVividFlower(0.78, 2.00, 'white');
            createVividFlower(0.85, 2.30, 'yellow');

      // ★ 有害物質沉積點（矗立於白花照明舞台正中央）
            const toxicGroup = new THREE.Group();
            toxicGroup.position.set(0.55, 0.09, 2.05);
            const toxicCrystalGeo = new THREE.DodecahedronGeometry(0.24, 1);
            const toxicMat = new THREE.MeshStandardMaterial({
              color: 0x052b18,
              emissive: 0x00ff77,
              emissiveIntensity: 0.55,
              roughness: 0.18,
              metalness: 0.85
            });
            toxicGroup.add(new THREE.Mesh(toxicCrystalGeo, toxicMat));
            scene.add(toxicGroup);

      // ----------------------------------------------------
        // 4. 生物本體（飽滿圓頭、整條順滑長橢圓體）
        // ----------------------------------------------------
        const bodyLength = 3.8;
        const radialSegs = 50; // 維持 50 細分度
        const heightSegs = 40;

        // ★ 使用球體沿軸線拉伸，形成一體成型、無接縫平面的長橢圓體（圓頭與圓尾）
        const bodyGeo = new THREE.SphereGeometry(1.0, radialSegs, heightSegs);
        bodyGeo.scale(0.38, 0.25, bodyLength / 2); // X 橫寬 0.38，Y 扁平厚度 0.25，Z 半長度 1.9

        const posAttr = bodyGeo.attributes.position;
        const basePositions = posAttr.array.slice();
        const totalVertices = posAttr.count;

        // 高折射物理透明材質
        const creatureMat = new THREE.MeshPhysicalMaterial({
          color: 0xffffff,
          transmission: 0.95,
          opacity: 1,
          transparent: true,
          roughness: 0.04,
          ior: 1.5,
          reflectivity: 0.96,
          clearcoat: 1.0,
          clearcoatRoughness: 0.05,
          depthWrite: false
        });

        const creatureBody = new THREE.Mesh(bodyGeo, creatureMat);
        scene.add(creatureBody);

    // ----------------------------------------------------
        // 5. 觸角系統（具備實體粗度、同樣物理透明、支援斷裂脫落）
        // ----------------------------------------------------
        // ★ 物理級透明膠質材質（賦予觸角與身體相同的玻璃/水母肉質厚度）
        const antennaMat = new THREE.MeshPhysicalMaterial({
          color: 0xffffff,
          transmission: 0.92,
          opacity: 1,
          transparent: true,
          roughness: 0.08,
          ior: 1.48,
          reflectivity: 0.95,
          clearcoat: 1.0,
          clearcoatRoughness: 0.05,
          depthWrite: false
        });
    
        // 斷裂掉落的斷肢碎片（用於強調裂解感）
        const severedTipGeo = new THREE.CylinderGeometry(0.015, 0.035, 0.35, 8);
        const severedTipMat = new THREE.MeshStandardMaterial({
          color: 0x221118,
          emissive: 0x00ff88,
          emissiveIntensity: 1, // 接觸毒物後瞬間碳化與毒化發光
          roughness: 0.7
        });
        const severedTip = new THREE.Mesh(severedTipGeo, severedTipMat);
        severedTip.visible = false;
        scene.add(severedTip);
    
        // 左右實體觸角網格
        const leftAntennaMesh = new THREE.Mesh(new THREE.BufferGeometry(), antennaMat);
        const rightAntennaMesh = new THREE.Mesh(new THREE.BufferGeometry(), antennaMat);
        scene.add(leftAntennaMesh);
        scene.add(rightAntennaMesh);
    
        // 裂解劇烈爆發微粒（腐蝕碎屑）
        const pCount = 50;
        const pGeo = new THREE.BufferGeometry();
        const pPos = new Float32Array(pCount * 3);
        const pVelo = [];
        for (let i = 0; i < pCount; i++) {
          pPos[i * 3] = 0; pPos[i * 3 + 1] = -100; pPos[i * 3 + 2] = 0;
          pVelo.push({ x: 0, y: 0, z: 0, life: 0 });
        }
        pGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
        const pMat = new THREE.PointsMaterial({
          color: 0x00ff99,
          size: 0.08,
          transparent: true,
          opacity: 0.9,
          blending: THREE.AdditiveBlending
        });
        const degradeParticles = new THREE.Points(pGeo, pMat);
        scene.add(degradeParticles);
    
        // 視窗自適應
        window.addEventListener('resize', () => {
          camera.aspect = window.innerWidth / window.innerHeight;
          camera.updateProjectionMatrix();
          renderer.setSize(window.innerWidth, window.innerHeight);
        });
    
// ----------------------------------------------------
            // 6. 動態時間軸控制（前進 -> 原地觸碰裂解 -> 縮回 -> 再生 ->繼續前進）
            // ----------------------------------------------------
            const clock = new THREE.Clock();
            const CYCLE_TIME = 13.0; // 循環擴展為 13 秒以容納完整行為
            const statusText = document.getElementById('status-tag');
        
            // ★ 毒物結晶所在座標（白花焦點照明區）
            const TOXIC_POS = new THREE.Vector3(0.55, 0.16, 2.05);
        
            function animate() {
              requestAnimationFrame(animate);
              const time = clock.getElapsedTime();
              const progress = time % CYCLE_TIME;
        
              let creatureX = 0;
              let creatureZ = -1.8;
              let creatureRotY = 0;
              let rightAntennaScale = 1.0;
              let isDegrading = false;
              let isRetracting = false;
              let isRegenerating = false;
              let isAdvancing = false;
        
              // --- 狀態機階段 ---
              if (progress < 3.5) {
                // [階段 1] 緩緩向前移動接近目標
                const r = progress / 3.5;
                creatureZ = -1.8 + r * 1.2;
                creatureX = 0;
                creatureRotY = 0;
                rightAntennaScale = 1.0;
                statusText.innerText = "向前探巡移動中";
                statusText.style.color = "#ffffff";
                severedTip.visible = false;
              }
              else if (progress < 5.8) {
                // [階段 2] 右側觸角碰觸毒物並在該區域發生劇烈裂解
                creatureZ = -0.6;
                creatureX = 0;
                creatureRotY = 0;
                const degR = (progress - 3.5) / 2.3;
                isDegrading = true;
        
                rightAntennaScale = Math.max(0.45, 1.0 - degR * 0.9);
        
                severedTip.visible = true;
                severedTip.position.set(TOXIC_POS.x + 0.05, Math.max(0.08,
                0.25 - degR * 0.2), TOXIC_POS.z);
                severedTip.rotation.x += 0.05;
                severedTip.rotation.z += 0.08;
        
                if (progress < 4.8) {
                  spawnBurstParticles(TOXIC_POS.x, 0.2, TOXIC_POS.z);
                }
        
                statusText.innerText = "碰觸毒物！尖端劇烈腐蝕並原地斷裂裂解！";
                statusText.style.color = "#ff3366";
              }
              else if (progress < 7.6) {
                // [階段 3] 遭受刺激，畏縮後退並迅速轉向左方避障
                const retR = (progress - 5.8) / 1.8;
                creatureZ = -0.6 - Math.sin(retR * Math.PI) * 0.35;
                creatureX = -Math.sin(retR * Math.PI * 0.5) * 0.38;
                creatureRotY = -retR * 0.48;
                isRetracting = true;
                rightAntennaScale = 0.45 * (1.0 - retR * 0.4);
        
                statusText.innerText = "受損畏縮後退，感知危險並轉向避障！";
                statusText.style.color = "#ffaa33";
              }
              else if (progress < 9.8) {
                // [階段 4] 偏向安全繞道，同時高速再生
                const regR = (progress - 7.6) / 2.2;
                creatureZ = -0.6 - 0.08 * (1.0 - regR);
                creatureX = -0.38 - regR * 0.38;
                creatureRotY = -0.48 + regR * 0.12;
                isRegenerating = true;
                rightAntennaScale = 0.27 + regR * 0.73;
        
                statusText.innerText = "避開危險源！向左繞道並高速再生觸角";
                statusText.style.color = "#00ffcc";
              }
              else {
                // [階段 5] 再生完成，沿左側弧線繞過毒物與危險花叢繼續推進
                const advR = (progress - 9.8) / 3.2;
                creatureZ = -0.6 + advR * 1.8;
                creatureX = -0.76 - Math.sin(advR * Math.PI) * 0.35;
                creatureRotY = -0.36 * Math.cos(advR * Math.PI * 0.5);
                rightAntennaScale = 1.0;
                isAdvancing = true;
        
                statusText.innerText = "成功繞過毒物與危險花叢，沿安全路徑前進";
                statusText.style.color = "#ffff66";
              }
        
              // --- (A) 身體流體蠕動 ---
              const pos = bodyGeo.attributes.position.array;
              const speed = 2.6;
              const freq = 1.8;
        
              for (let i = 0; i < totalVertices; i++) {
                const ox = basePositions[i * 3];
                const oy = basePositions[i * 3 + 1];
                const oz = basePositions[i * 3 + 2];
        
                const waveX = Math.sin(time * speed - oz * freq) * 0.22;
                const waveY = Math.cos(time * 3.0 - oz * 2.0) * 0.05;
                const ripple = Math.sin(ox * 8.0 + oy * 8.0 + time * 4.0) *
                0.012;
        
                pos[i * 3]     = ox + waveX;
                pos[i * 3 + 1] = oy + waveY + ripple;
                pos[i * 3 + 2] = oz;
              }
              bodyGeo.attributes.position.needsUpdate = true;
              bodyGeo.computeVertexNormals();
        
              creatureBody.position.x = creatureX;
              creatureBody.position.z = creatureZ;
              creatureBody.position.y = 0.45 + Math.sin(time * 1.6) * 0.04;
              creatureBody.rotation.y = creatureRotY;
        
              // --- (B) 實體立體厚度觸角動態生成（包含轉向計算）---
              const cosR = Math.cos(creatureRotY);
              const sinR = Math.sin(creatureRotY);
              const waveXHead = Math.sin(time * speed - (bodyLength / 2) *
              freq) * 0.22;
              const halfLen = bodyLength / 2;

              const headX = creatureBody.position.x + waveXHead * cosR +
              halfLen * sinR;
              const headY = creatureBody.position.y;
              const headZ = creatureBody.position.z - waveXHead * sinR +
              halfLen * cosR;
        
              updateTubularAntenna(leftAntennaMesh, true, headX, headY,
              headZ, creatureRotY, time, 1.0, false, false);
              updateTubularAntenna(rightAntennaMesh, false, headX, headY,
              headZ, creatureRotY, time, rightAntennaScale, isDegrading,
              isRegenerating);
        
              // --- (C) 更新粒子 ---
              updateParticles();
        
              controls.update();
              renderer.render(scene, camera);
            }
        
            // ★ 建立具備 3D 圓管粗度的流動觸角（支援身體轉向 rotY）
            function updateTubularAntenna(mesh, isLeft, hx, hy, hz, rotY,
            time, lengthScale, degrading, regenerating) {
              const sign = isLeft ? -1 : 1;
              const curvePoints = [];
              const segs = 10;
              const fullLen = 0.95 * lengthScale;
              const cosR = Math.cos(rotY);
              const sinR = Math.sin(rotY);
        
              for (let i = 0; i <= segs; i++) {
                const p = i / segs;
                let wx = 0;
                let wy = 0;
        
                if (!degrading) {
                  wx = Math.sin(time * 3.8 + i * 0.4) * p * 0.18;
                  wy = Math.cos(time * 4.2 + i * 0.45) * p * 0.12;
                }
        
                const locX = sign * (0.12 + p * 0.25) + wx;
                const locY = 0.04 + p * 0.15 + wy;
                const locZ = p * fullLen;

                let worldX = hx + (locX * cosR + locZ * sinR);
                let worldY = hy + locY;
                let worldZ = hz + (-locX * sinR + locZ * cosR);

                if (degrading) {
                  const pull = p * p;
                  worldX += (TOXIC_POS.x - (hx + (sign * 0.12 * cosR +
                  fullLen * sinR))) * pull;
                  worldY += (TOXIC_POS.y - (hy + 0.04)) * pull;
                  worldZ += (TOXIC_POS.z - (hz + (-sign * 0.12 * sinR +
                  fullLen * cosR))) * pull;
                }
        
                curvePoints.push(new THREE.Vector3(worldX, worldY, worldZ));
              }

              const curve = new THREE.CatmullRomCurve3(curvePoints);
              if (mesh.geometry) mesh.geometry.dispose();
              mesh.geometry = new THREE.TubeGeometry(curve, 16, 0.036, 8,
              false);

              if (regenerating) {
                mesh.material.emissive = new THREE.Color(0x00ffcc);
                mesh.material.emissiveIntensity = 0.6;
              } else {
                mesh.material.emissive = new THREE.Color(0x000000);
                mesh.material.emissiveIntensity = 0;
              }
            }
    
            // 觸角裂解噴發粒子
            function spawnBurstParticles(x, y, z) {
              const p = degradeParticles.geometry.attributes.position.array;
              for (let i = 0; i < pCount; i++) {
                p[i * 3]     = x + (Math.random() - 0.5) * 0.08;
                p[i * 3 + 1] = y + (Math.random() - 0.5) * 0.08;
                p[i * 3 + 2] = z + (Math.random() - 0.5) * 0.08;
                pVelo[i] = {
                  x: (Math.random() - 0.5) * 0.04,
                  y: Math.random() * 0.04 + 0.01,
                  z: (Math.random() - 0.5) * 0.04,
                  life: 1.0
                };
              }
              degradeParticles.geometry.attributes.position.needsUpdate =
              true;
            }

            function updateParticles() {
              const p = degradeParticles.geometry.attributes.position.array;
              for (let i = 0; i < pCount; i++) {
                if (pVelo[i].life > 0) {
                  p[i * 3]     += pVelo[i].x;
                  p[i * 3 + 1] += pVelo[i].y;
                  p[i * 3 + 2] += pVelo[i].z;
                  pVelo[i].y   -= 0.0015;
                  pVelo[i].life -= 0.025;
                  if (pVelo[i].life <= 0) p[i * 3 + 1] = -100;
                }
              }
              degradeParticles.geometry.attributes.position.needsUpdate =
              true;
            }

            animate();
      </script>
    </body>
